# Optional overrides for docker compose (copy to .env at the repository root).
# CoinGecko key: free Demo plan at https://www.coingecko.com/en/api
COINGECKO_API_KEY=
COINGECKO_API_PLAN=public

# Host ports (change if they clash with other local stacks)
VORYN_WEB_PORT=3010
VORYN_API_PORT=8010
VORYN_POSTGRES_PORT=5442
VORYN_REDIS_PORT=6389
VORYN_MAILPIT_PORT=8035
