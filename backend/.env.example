# Copy to .env for running the API on the host (outside Docker).
ENVIRONMENT=development
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://voryn:voryn@localhost:5442/voryn
REDIS_URL=redis://localhost:6389/0
FRONTEND_URL=http://localhost:3010
COOKIE_SECURE=false
EMAIL_BACKEND=console
EMAIL_DELIVERY=inline
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEYS=
# Optional: https://www.coingecko.com/en/api (demo keys are free)
COINGECKO_API_KEY=
COINGECKO_API_PLAN=public

# Voryn AI (optional): https://console.anthropic.com — model defaults to claude-opus-5-5
ANTHROPIC_API_KEY=
